# Copy this file to .env and fill in only the keys you have.
# .env is git-ignored. Never commit real keys.
# Every key is optional: providers without a key are skipped, not crashed.

# --- L2/L3 Geolocation & network (Phase 2) ---
# IPinfo Lite (free, unlimited, country + ASN): https://ipinfo.io/lite
IPINFO_TOKEN=
# MaxMind GeoLite2: IP Finder reads the .mmdb files (see data/README.md).
# With both values set, "ipfinder update-lists" downloads them for you
# (account ID and license key from your free MaxMind account page).
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# PeeringDB (optional; raises anonymous rate limits)
PEERINGDB_API_KEY=

# --- L9 Threat reputation (Phase 5; used with --profile full) ---
# AbuseIPDB (free: ~1,000 checks/day)
ABUSEIPDB_API_KEY=
# GreyNoise Community (optional key; IPv4 only; free account: 50 lookups/week)
GREYNOISE_API_KEY=
# VirusTotal (free public API: 4 requests/min, 500/day, non-commercial)
VIRUSTOTAL_API_KEY=
# AlienVault OTX
OTX_API_KEY=
# abuse.ch (ThreatFox/URLhaus/Feodo) - Auth-Key mandatory since 30 June 2025
ABUSECH_AUTH_KEY=
# Spamhaus Data Query Service (free, non-commercial; needed when your resolver is a
# public one like 8.8.8.8, which Spamhaus refuses)
SPAMHAUS_DQS_KEY=

# --- Paths (defaults shown; relative paths are relative to the current folder) ---
# IEEE OUI list used to name the vendor behind an EUI-64 IPv6 address
# IPFINDER_OUI_DB=data/oui.csv
# MaxMind GeoLite2 databases
# IPFINDER_MAXMIND_CITY_DB=data/GeoLite2-City.mmdb
# IPFINDER_MAXMIND_ASN_DB=data/GeoLite2-ASN.mmdb
# Lookup cache (delete any time, or run: ipfinder cache clear)
# IPFINDER_CACHE=data/cache.sqlite
# Downloaded lists: Tor exits, cloud ranges, Private Relay, VPN (ipfinder update-lists)
# IPFINDER_LISTS_DIR=data/lists
# Your own location (latitude,longitude) for the speed-of-light check with --active.
# Without it, the location of your public IP (from ip-api, about +-100 km) is used.
# IPFINDER_LOCATION=23.8103,90.4125
